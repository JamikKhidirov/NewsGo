{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Requests / sec",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(gonews_http_requests_total[5m]))" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "p99 latency",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.99, sum(rate(gonews_http_request_duration_seconds_bucket{route!~\"/api/v1/admin/.*\"}[5m])) by (le))" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 1 }] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "5xx ratio",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "(sum(rate(gonews_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(gonews_http_requests_total[5m])), 0.001)) or vector(0)" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 }] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "In-flight requests",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "gonews_http_in_flight_requests" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Throughput by route",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (route) (rate(gonews_http_requests_total[5m]))", "legendFormat": "{{route}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(gonews_http_request_duration_seconds_bucket{route!~\"/api/v1/admin/.*\"}[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(gonews_http_request_duration_seconds_bucket{route!~\"/api/v1/admin/.*\"}[5m])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(gonews_http_request_duration_seconds_bucket{route!~\"/api/v1/admin/.*\"}[5m])) by (le))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "PostgreSQL pool",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "gonews_db_pool_open_connections", "legendFormat": "open" },
        { "refId": "B", "expr": "gonews_db_pool_in_use", "legendFormat": "in use" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Cache operations",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (result) (rate(gonews_cache_operations_total{op=\"get\"}[5m]))", "legendFormat": "{{result}}" }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Kafka events",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (direction, topic, result) (rate(gonews_kafka_messages_total[5m]))", "legendFormat": "{{direction}} {{topic}} {{result}}" }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Push deliveries by platform",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (platform, result) (rate(gonews_push_deliveries_total[10m]))", "legendFormat": "{{platform}} {{result}}" }],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Ingestion",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(gonews_ingest_articles_total{result=\"inserted\"}[10m])) or vector(0)", "legendFormat": "inserted/s" },
        { "refId": "B", "expr": "sum(rate(gonews_ingest_articles_total{result=\"updated\"}[10m])) or vector(0)", "legendFormat": "updated/s" },
        { "refId": "C", "expr": "sum(rate(gonews_provider_errors_total[10m])) or vector(0)", "legendFormat": "provider errors/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } }, "overrides": [] }
    },
    {
      "type": "logs",
      "title": "Application logs (Loki)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{service=\"gonews\"} |= \"\"" }],
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "sortOrder": "Descending" }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["gonews", "api", "postgres", "kafka"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "GoNews — API, ingestion and delivery",
  "uid": "gonews-overview",
  "version": 1
}
