# GoNews — пример конфигурации.
# Скопируйте файл в .env и измените значения.
# Переменные окружения имеют приоритет над .env.

# --- Основное ---
GONEWS_ENV=development
GONEWS_LOG_LEVEL=info
GONEWS_HTTP_ADDR=:8080
GONEWS_PUBLIC_BASE_URL=http://localhost:8080
GONEWS_DB_PATH=data/gonews.db

# --- Безопасность ---
# В production обязательно замените на длинную случайную строку.
GONEWS_JWT_SECRET=dev-insecure-secret-change-me
GONEWS_ACCESS_TTL=30m
GONEWS_REFRESH_TTL=720h
# Сервисный токен для /api/v1/admin/* (заголовок X-Admin-Token).
GONEWS_ADMIN_TOKEN=devadmin
# Email-ы через запятую, которые получают роль admin при регистрации.
GONEWS_ADMIN_EMAILS=

# --- HTTP ---
GONEWS_CORS_ORIGINS=*
GONEWS_RATE_LIMIT_PER_MINUTE=180

# --- Сбор новостей ---
GONEWS_INGEST_ON_START=true
GONEWS_INGEST_INTERVAL=10m
GONEWS_INGEST_TIMEOUT=90s
# Пусто = все источники. Пример: GONEWS_PROVIDERS=lenta,ria,habr,hackernews
GONEWS_PROVIDERS=
GONEWS_PROVIDER_LIMIT=25
GONEWS_USER_AGENT=GoNewsBot/1.0 (+https://github.com/gonews/gonews)
GONEWS_RETENTION_DAYS=90

# --- Перевод ---
GONEWS_TRANSLATE_ENABLED=true
GONEWS_TRANSLATE_PROVIDERS=google,lingva,mymemory,libretranslate
GONEWS_TRANSLATE_TARGETS=ru
GONEWS_TRANSLATE_WORKERS=2
GONEWS_TRANSLATE_TIMEOUT=12s
GONEWS_TRANSLATE_MAX_CHARS=4500
GONEWS_LIBRETRANSLATE_URL=https://libretranslate.com
GONEWS_LINGVA_URL=https://lingva.ml

# --- Push (FCM HTTP v1) ---
GONEWS_PUSH_ENABLED=false
GONEWS_FCM_PROJECT_ID=
GONEWS_FCM_SERVICE_ACCOUNT_FILE=
GONEWS_PUSH_BROADCAST=true
GONEWS_PUSH_INTERVAL=30m
GONEWS_PUSH_MIN_SCORE=20
